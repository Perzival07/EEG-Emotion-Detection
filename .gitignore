# ===============================
# Project-specific ignores
# ===============================

# Dataset (large files not tracked in Git)
dataset/
*.zip

# EEG-comparative analysis: raw datasets (download separately, see
# "EEG-comparative analysis/README.md" for links) and regenerable feature
# caches -- too large for Git (multi-GB, some files exceed GitHub's 100MB
# per-file limit).
EEG-comparative analysis/deap-dataset/
EEG-comparative analysis/seed-dataset/
EEG-comparative analysis/processed_cache/

# Model files (trained weights & metadata)
*.keras
*.h5
*.pb
*.tflite
*.json

# Training logs (TensorBoard and others)
logs/
*.log
*.ckpt
checkpoints/

# ===============================
# Python-specific ignores
# ===============================

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.env/
*.conda
*.egg-info/

# ===============================
# Jupyter Notebook ignores
# ===============================
.ipynb_checkpoints/

# ===============================
# OS / Editor files
# ===============================
.DS_Store
Thumbs.db
